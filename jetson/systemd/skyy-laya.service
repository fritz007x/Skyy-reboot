[Unit]
Description=Skyy decision model - Laya (llama-server :8081)
After=network-online.target jetson-clocks.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=@USER@
EnvironmentFile=/etc/skyy/laya.env
# Laya has its own llama.cpp build (build-laya/)
ExecStart=@HOME@/llama.cpp/build-laya/bin/llama-server -m ${MODEL} --host 0.0.0.0 --port 8081 -ngl 99
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
